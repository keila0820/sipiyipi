<label>Mensaje dentro del sobre secreto</label><textarea id="editSecret">Gracias por salvarme, eres mi sipiyipi y el amor de mi vida. Te smo. ♡</textarea>
<h3 style="font:30px 'Cormorant Garamond',serif">Lugares especiales</h3><label>Escribe cada lugar en una línea: nombre | descripción</label><textarea id="editPlaces" placeholder="La calle donde nos cruzamos | Nuestro primer encuentro&#10;El parque | Donde decidimos estar juntos"></textarea>
<button onclick="saveAll()">Guardar en esta página</button><button onclick="exportProject()">Descargar mi página completa</button><button onclick="document.getElementById('importProject').click()">Cargar mi copia guardada</button><input id="importProject" type="file" accept="application/json" hidden><button onclick="closeEditor()">Cerrar</button>
<p class="note">Consejo: después de añadir fotos y audios, pulsa «Descargar mi página completa». Ese archivo HTML incluirá tus cambios y podrás abrirlo o compartirlo. Guarda una copia original por seguridad.</p></div></div>
<script>
window.__SAVED_PROJECT__={"intro":"Hay historias que llegan sin esperarlas y personas que, sin saber cómo, te cambian la vida. A veces dos almas coinciden y conectan de una forma tan especial que parece que el destino las hubiera preparado para encontrarse.\n\nNuestra historia no empezó el día en que nos convertimos en pareja. Empezó mucho antes, cuando nos cruzamos en la calle sin imaginar que aquel encuentro cambiaría nuestras vidas. Desde entonces, algo nos unió; por más que la vida nos llevara por caminos distintos, nuestros destinos siempre encontraron la forma de volver a acercarnos.\n\nDicen que hay hilos rojos que pueden estirarse y enredarse, pero nunca romperse. El nuestro nos llevó de nuevo a aquel parque, donde, sin saberlo, estaba tomando la mejor decisión de mi vida: elegir quedarme contigo.\n\nNo necesitábamos una historia perfecta; solo volver a encontrarnos y descubrir todo lo bonito que podíamos construir juntos. Me alegra que haya sido contigo. Me acompañaste, me ayudaste a sanar y llenaste mi vida de un amor que nunca imaginé. Por eso, y por todo lo que somos, eres el amor de mi vida.","photos":["data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,"],"photoCaptions":["De nuestras primeras fotos.","Ojalá siempre me mires así.","El super pollo.","Tú y yo sabemos, jsjsjs.","Espero recibir estos detalles por el resto de mi vida.","Nuestra primera noche durmiendo juntos."],"songs":[{"title":"Te Amé","artist":"Kelvis Ochoa","note":"Forma parte de nuestra historia."},{"title":"Estrella Fugaz","artist":"Beéle","note":"¿Qué vamo' a hacer tú y yo? ¡Nada!"},{"title":"La Medalla","artist":"Camilo y Evaluna","note":"Justo lo que siento por ti."}],"songsAudio":["data:audio/mp4;base64,","data:audio/mpeg;base64,","data:audio/mp4;base64,"],"voice":"data:audio/mp4;base64,","secret":"Gracias por salvarme, eres mi sipiyipi y el amor de mi vida. Te amo. ♡","places":[{"name":"El carrito donde nos cruzamos.","desc":"El destino decidió juntar nuestros caminos."},{"name":"El parquecito del edificio.","desc":"Nuestro primer beso y nuestro primer encuentro."}]};
const $=id=>document.getElementById(id);
let project=window.__SAVED_PROJECT__||{intro:$('introText').textContent,photos:[],photoCaptions:[],songs:[{}, {}, {}],voice:null,secret:$('secret').textContent,places:[]};
const observer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('section,.event,.polaroid,.track,.reason').forEach(x=>{x.classList.add('reveal');observer.observe(x)});
function flash(){const f=$('flash');f.classList.remove('go');void f.offsetWidth;f.classList.add('go')}
document.querySelectorAll('section').forEach(s=>new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)flash()}),{threshold:.65}).observe(s));
function tick(){let start=new Date('2025-12-04T14:30:00-05:00'),sec=Math.max(0,Math.floor((Date.now()-start)/1000)),d=Math.floor(sec/86400);sec%=86400;let h=Math.floor(sec/3600);sec%=3600;let m=Math.floor(sec/60);sec%=60;$('timer').textContent=`${d} : ${String(h).padStart(2,'0')} : ${String(m).padStart(2,'0')} : ${String(sec).padStart(2,'0')}`}
tick();setInterval(tick,1000);
function openEditor(){$('editor').classList.add('open');$('editIntro').value=project.intro;$('editSecret').value=project.secret;$('photoCaptions').value=project.photoCaptions.join(' | ');project.songs.forEach((s,i)=>{['title','artist','note'].forEach(k=>{if(s[k])$('song'+(i+1)+k).value=s[k]})});$('editPlaces').value=project.places.map(p=>p.name+' | '+p.desc).join('\n')}
function closeEditor(){$('editor').classList.remove('open')}
function fileData(f){return new Promise((res,rej)=>{let r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(f)})}
async function saveAll(){
 project.intro=$('editIntro').value;project.secret=$('editSecret').value;project.photoCaptions=$('photoCaptions').value.split('|').map(x=>x.trim()).filter(Boolean);
 const photos=[...$('editPhotos').files];if(photos.length)project.photos=await Promise.all(photos.slice(0,12).map(fileData));
 const audios=[...$('editSongs').files];if(audios.length)project.songsAudio=await Promise.all(audios.slice(0,3).map(fileData));
 project.songs=project.songs.map((s,i)=>({title:$('song'+(i+1)+'title').value||`Canción ${i+1}`,artist:$('song'+(i+1)+'artist').value||'Artista',note:$('song'+(i+1)+'note').value||'Una canción que forma parte de nosotros.'}));
 const voice=$('editVoice').files[0];if(voice)project.voice=await fileData(voice);
 project.places=$('editPlaces').value.split('\n').map(line=>{let a=line.split('|');return {name:(a[0]||'Lugar especial').trim(),desc:(a[1]||'Un recuerdo nuestro.').trim()}}).filter(p=>p.name);
 renderProject();closeEditor();alert('¡Listo! Tus cambios ya están en esta página. Descarga tu página completa para conservarlos.');
}
function renderProject(){
 $('introText').textContent=project.intro;$('secret').textContent=project.secret;
 if(project.photos.length){$('gallery').innerHTML=project.photos.map((src,i)=>`<figure class="polaroid" style="--rot:${i%2?'2deg':'-1deg'}"><img src="${src}"><figcaption>${escapeHtml(project.photoCaptions[i]||'Un recuerdo nuestro')}</figcaption></figure>`).join('')}
 if(project.songsAudio||project.songs.some(s=>s.title)){
 $('songs').innerHTML=project.songs.map((s,i)=>`<article class="track"><div class="cover"><span>0${i+1} · ${escapeHtml(s.title||'Nuestra canción')}</span></div><h3>${escapeHtml(s.title||'Nuestra canción')}</h3><div class="artist">${escapeHtml(s.artist||'Artista')}</div><p>${escapeHtml(s.note||'Una canción que forma parte de nosotros.')}</p>${project.songsAudio?.[i]?`<audio controls src="${project.songsAudio[i]}"></audio>`:'<div class="note">Puedes añadir el audio desde «Editar recuerdos».</div>'}</article>`).join('')}
 if(project.voice){$('voiceSlot').innerHTML='<audio id="personalVoice" controls src="'+project.voice+'"></audio>';$('voicePlay').style.display='none'}
 if(project.places.length)$('places').innerHTML=project.places.map(p=>`<article class="place"><small>Un lugar de nuestra historia</small><strong>${escapeHtml(p.name)}</strong><p>${escapeHtml(p.desc)}</p></article>`).join('');
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
$('envelope').addEventListener('click',()=>{$('envelope').classList.toggle('open');$('secret').classList.toggle('show')});
$('envelope').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();$('envelope').click()}});
$('voicePlay').addEventListener('click',()=>{let a=$('personalVoice');if(a){a.paused?a.play():a.pause()}else alert('Añade tu grabación desde «Editar recuerdos».')});
function exportProject(){
 const copy='<!doctype html>\n'+document.documentElement.outerHTML;
 const data={...project};
 const marker='/*PROJECT_DATA*/';
 let src=copy.replace('let project={intro:',`let project=${JSON.stringify(data)};/*RESTORE*/\n/*let project={intro:`).replace('};\nconst observer=',`};*/\nconst observer=`);
 // Save the full rendered page with its assets by embedding the project in a boot script.
 const payload=JSON.stringify(data).replace(/</g,'\\u003c');
 const final=copy.replace('<script>\nconst $=',`<script>window.__SAVED_PROJECT__=${payload};\nconst $=`);
 const blob=new Blob([final],{type:'text/html'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='nuestra-historia-completa.html';a.click();URL.revokeObjectURL(a.href);
}
$('importProject').addEventListener('change',async e=>{let f=e.target.files[0];if(!f)return;try{let d=JSON.parse(await f.text());project={...project,...d};renderProject();alert('Copia cargada.')}catch(err){alert('No se pudo leer ese archivo.')}});
if(window.__SAVED_PROJECT__){project={...project,...window.__SAVED_PROJECT__};renderProject()}
</script></body></html>